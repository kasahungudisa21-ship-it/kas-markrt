# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional External Firebase / Vercel Deployment Overrides:
# Leave these unset in AI Studio (it uses firebase-applet-config.json automatically).
# When deploying to Vercel with your own Firebase project (e.g. kas market),
# add these exact variable names in Vercel -> Settings -> Environment Variables.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# Optional: only set VITE_FIREBASE_DATABASE_ID if not using "(default)" Firestore database
VITE_FIREBASE_DATABASE_ID=""
VITE_ADMIN_EMAIL="kasahungudisa12@gmail.com"
